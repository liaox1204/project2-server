# ===== 银发AI语音生活助手 后端环境变量示例 =====
# 复制本文件为 .env 并填写（config/settings.py 会自动加载项目根目录的 .env）

# JWT 密钥（生产环境请务必修改为随机字符串）
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ===== 大模型配置（OpenAI 兼容接口）=====
# 任选一家，填入对应三个值即可：

# ① DeepSeek（推荐，便宜好用）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ② 通义千问（DashScope 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus

# ③ 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxxxxxxxxxxxxxxx
# LLM_MODEL=glm-4-flash

# ④ 月之暗面 Kimi
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=moonshot-v1-8k

# ⑤ OpenAI 官方
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT=15

# ===== 语音识别 ASR（硅基流动 SiliconFlow，OpenAI 兼容）=====
# ASR_KEY 与 LLM_API_KEY 可分开，也可复用同一个硅基流动 Key
ASR_BASE_URL=https://api.siliconflow.com/v1
ASR_API_KEY=sk-xxxxxxxxxxxxxxxx
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 高风险订单确认金额阈值（元，超过此金额需二次确认）
ORDER_CONFIRM_AMOUNT_THRESHOLD=100
